# 宿主机映射端口（浏览器访问 http://localhost:${HOST_PORT}）
HOST_PORT=3000

# 会话有效期（毫秒），默认 12 小时
SESSION_TTL_MS=43200000

# 首次启动初始化的三类种子账户（仅在数据库用户表为空时生效）
# 生产部署请改成强密码
SEED_RECORDIST_USER=recorder
SEED_RECORDIST_PASS=recorder123
SEED_REVIEWER_USER=reviewer
SEED_REVIEWER_PASS=reviewer123
SEED_PARTICIPANT_USER=participant
SEED_PARTICIPANT_PASS=participant123
